rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    
    // User Artifacts and Personal FitTrack Data
    match /artifacts/{appId}/users/{userId}/{document=**} {
      // Allow authenticated user to read and write their own workout logs, exercises, and measurements
      allow read, write: if request.auth != null && request.auth.uid == userId;
    }
    
    // Public / System Preset Fallback Read Access
    match /artifacts/{appId}/system_presets/{document=**} {
      allow read: if true;
      allow write: if request.auth != null;
    }

    // Bugs & Feedback: Anyone authenticated can submit, only admin can view or delete
    match /feedback/{document=**} {
      allow create: if request.auth != null;
      allow read, delete: if request.auth != null && request.auth.token.email == 'adamjkosicki@gmail.com';
    }
  }
}
